# ╔══════════════════════════════════════════════════════╗
# ║   ULTRA V5.6 ENTERPRISE ENGINE — API KEY TEMPLATE   ║
# ║   Copy this to .env and fill in your real values    ║
# ╚══════════════════════════════════════════════════════╝

# ── Binance ──────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_here

# ── Bybit ────────────────────────────────────────────────
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET_KEY=your_bybit_secret_here

# ── KuCoin ───────────────────────────────────────────────
KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_SECRET_KEY=your_kucoin_secret_here
KUCOIN_PASSPHRASE=your_kucoin_passphrase_here

# ── Alpha Vantage (Gold/Forex/Stocks) ────────────────────
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ── CoinGecko (Pro optional) ─────────────────────────────
COINGECKO_API_KEY=your_coingecko_key_here

# ── Telegram Bot ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Trading Configuration ────────────────────────────────
PAPER_TRADING=true          # Set to false for LIVE trading
MAX_RISK_PERCENT=1.0        # Max % of portfolio per trade
DEFAULT_EXCHANGE=binance    # binance | bybit | kucoin
BASE_CURRENCY=USDT
INITIAL_PAPER_BALANCE=10000.0

# ── App Settings ─────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_this_to_a_long_random_string
LOG_LEVEL=INFO
